# Production environment configuration.
# Copy to .env, then fill the secrets using the output of `make secrets`.
# NEVER commit .env.

# --- Secrets (required) ------------------------------------------------------
# Signs password-reset/verification tokens.
BLINK_SECRET_KEY=
# Fernet key encrypting stored credentials (Blink account, SMTP, webhooks).
# Changing it makes previously stored credentials unreadable.
BLINK_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Networking (optional) ---------------------------------------------------
# Published ports for the TLS frontend.
BLINK_HTTP_PORT=80
BLINK_HTTPS_PORT=443
