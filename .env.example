# Production environment configuration.
# Copy to .env, then fill the secrets using the output of `make secrets`.
# NEVER commit .env.
#
# This file only lists what a typical deployment actually needs to touch -
# see docs/ENVIRONMENT.md for the full reference, including everything with
# a sensible built-in default (and why those aren't Settings-page fields).

# --- Secrets (required) ------------------------------------------------------
# Signs password-reset/verification tokens.
BLINK_SECRET_KEY=
# Fernet key encrypting stored credentials (Blink account, SMTP, webhooks).
# Changing it makes previously stored credentials unreadable.
BLINK_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# --- Networking (optional) ---------------------------------------------------
# Published ports for the TLS frontend.
BLINK_HTTP_PORT=80
BLINK_HTTPS_PORT=443
