{
  "name": "blink-frontend",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:coverage": "VITE_COVERAGE=true vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/vue": "^5.0.5",
    "@primeuix/themes": "^3.1.1",
    "pinia": "^4.1.0",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.5",
    "video.js": "^10.5.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "^5.5.0"
    },
    "brace-expansion": "^5.0.13",
    "js-beautify": {
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "@redocly/openapi-core": "^1.34.24",
    "@tsconfig/node24": "^24.0.6",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
