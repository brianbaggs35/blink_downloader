{
  "name": "blink-frontend",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:coverage": "VITE_COVERAGE=true vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify/vue": "^5.0.1",
    "@primeuix/themes": "^2.0.3",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "video.js": "^8.23.9",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.0"
    },
    "brace-expansion": "^5.0.8",
    "js-beautify": {
      "glob": "^13.0.6"
    }
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
